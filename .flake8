[flake8]
# maximum row's length
max-line-length = 100

# Errors to ignore
extend-ignore =
    E203,  
    W503,  
# E203=space before ':' in the slice (es. arr[1 : 3])
# W503=interruption of the row before binary operator

# File and directory to esclude from analysis
exclude =
    __pycache__,
    .git,
    node_modules,
    data,
    backend/core,
    .venv,
    venv,
    *.egg-info

# maximum cyclomatic complexity for every function
max-complexity = 10